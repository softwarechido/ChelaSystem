@startuml
class CervezaParams {
  - marca : Marca
  - tipo : TipoCerveza
  - granoBase : Grano
  - origen : Origen
  - tipo : TipoBotella
  + CervezaParams()
  + getGranoBase() : Grano
  + getMarca() : Marca
  + getOrigen() : Origen
  + getTipo() : TipoCerveza
  + setGranoBase(granoBase : Grano) : void
  + setMarca(marca : Marca) : void
  + setOrigen(origen : Origen) : void
  + setTipo(tipo : TipoCerveza) : void
  + matches(params : CervezaParams) : boolean
}

class Driver {
  - iniciarInventario()
  + main()
  - tests()
}

class Inventario {
  - cervezas : LinkedList<Cerveza>
  + Inventario()
  + addCerveza(cerveza : Cerveza) : void
  + getCerveza(serie : String) : Cerveza
  + search(chelaObjetivo : CervezaParams) : LinkedList
}

class Cerveza {
  - serie : String
  - lote : String
  - precio : double
  - params : CervezaParams
  + Cerveza()
  + getLote() : String
  + getParams() : CervezaParams
  + getPrecio() : double
  + getSerie() : String
  + setLote(lote : String) : void
  + setParams(params : CervezaParams) : void
  + setPrecio(precio : double) : void
  + setSerie(serie : String) : void
}

enum TipoBotella {
  + toString()
}

enum Grano {
  + toString()
}

enum Marca {
  + toString()
}

enum Origen {
  + toString()
}

enum TipoCerveza {
  + toString()
}

Cerveza --> CervezaParams : uses
CervezaParams --> TipoBotella
CervezaParams --> Grano
CervezaParams --> Marca
CervezaParams --> Origen
CervezaParams --> TipoCerveza
Inventario "1" *-- "*" Cerveza
Driver ..> Inventario : uses

@enduml
